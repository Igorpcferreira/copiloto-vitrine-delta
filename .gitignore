# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# assets gerados por cliente no build (scripts/prepare-site.mjs)
/public/*
!/public/brands
!/public/copiloto
!/public/defaults
!/public/demo
!/public/preview
!/public/showcase

# capturas geradas pelos roteiros de validação (ficam só no ambiente local)
/docs/previews/

.vercel
